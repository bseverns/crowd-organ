{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowd-organ.local/schemas/gesture_tuning.schema.json",
  "title": "Crowd Organ gesture_tuning.json",
  "type": "object",
  "properties": {
    "voice_history_capacity": { "type": "integer", "minimum": 1, "maximum": 600 },
    "voice": {
      "type": "object",
      "properties": {
        "raise_delta_y": { "type": "number", "minimum": 0.01, "maximum": 2.0 },
        "lower_delta_y": { "type": "number", "minimum": 0.01, "maximum": 2.0 },
        "swipe_delta_x": { "type": "number", "minimum": 0.01, "maximum": 2.0 },
        "swipe_orthogonality": { "type": "number", "minimum": 0.1, "maximum": 10.0 },
        "raise_horizontal_limit": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "swipe_vertical_limit": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "shake_radius": { "type": "number", "minimum": 0.01, "maximum": 2.0 },
        "shake_min_sign_flips": { "type": "integer", "minimum": 1, "maximum": 64 },
        "shake_min_motion": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
        "burst_speed_threshold": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "burst_max_speed": { "type": "number", "minimum": 0.01, "maximum": 100.0 },
        "hold_motion_threshold": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
        "hold_duration_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "min_window_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "max_window_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "gesture_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "burst_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "hold_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "zone": {
      "type": "object",
      "properties": {
        "history_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "sweep_window_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "sweep_min_steps": { "type": "integer", "minimum": 2, "maximum": 256 },
        "sweep_min_strength": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sweep_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "pulse_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "pulse_slope_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "pulse_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "history_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "eruption_low": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "eruption_high": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "eruption_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "eruption_window_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "stillness_motion_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "stillness_duration_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "stillness_min_voices": { "type": "integer", "minimum": 1, "maximum": 64 },
        "stillness_cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    }
  },
  "required": ["voice_history_capacity", "voice", "zone", "global"]
}
