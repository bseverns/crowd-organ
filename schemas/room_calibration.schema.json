{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowd-organ.local/schemas/room_calibration.schema.json",
  "title": "Crowd Organ room_calibration.json",
  "type": "object",
  "properties": {
    "_readme": {
      "type": "array",
      "items": { "type": "string" }
    },
    "room_name": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "kinect": {
      "type": "object",
      "properties": {
        "min_depth_mm": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_depth_mm": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "min_blob_area": { "type": "integer", "minimum": 1, "maximum": 500000 },
        "max_blob_area": { "type": "integer", "minimum": 1, "maximum": 2000000 },
        "max_voices": { "type": "integer", "minimum": 1, "maximum": 64 },
        "voice_match_distance": { "type": "number", "minimum": 0.01, "maximum": 2.0 }
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 15 },
          "label": { "type": "string" },
          "grid": {
            "type": "object",
            "properties": {
              "cols": { "type": "integer", "minimum": 1, "maximum": 16 },
              "rows": { "type": "integer", "minimum": 1, "maximum": 16 }
            },
            "required": ["cols", "rows"]
          },
          "ignored_zones": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "zone_labels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "required": ["id", "grid"]
      }
    }
  },
  "required": ["room_name", "kinect", "cameras"]
}
